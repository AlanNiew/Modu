{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨读",
  "mainBinaryName": "modu",
  "version": "0.3.2",
  "identifier": "com.alanview.epubreader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "墨读",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true,
        "backgroundColor": "#11111b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://epub.localhost data: blob:; style-src 'self' 'unsafe-inline' http://epub.localhost; font-src 'self' http://epub.localhost data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGRTk4OTE2QUREQUU3MUQKUldRZDU5cXRGb25wZjA2V1RmY25jT29OWkdoMW9iY3BReHc0RnhLT3Z1WjByWnVGRmVtK2VkS28K",
      "endpoints": [
        "https://github.com/AlanNiew/Modu/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "minimumWebview2Version": "110.0.1531.0"
    }
  }
}
